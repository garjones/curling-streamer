[Unit]
Description=Streamer compositor, sheet %i
Documentation=file:///opt/streamer/README.md
After=streamer-mediamtx.service
Wants=streamer-mediamtx.service

[Service]
User=streamer
Group=streamer
# GPU access for VAAPI/QSV encoding
SupplementaryGroups=video render
EnvironmentFile=/etc/streamer/sheet-%i.env
# Stream keys and camera credentials. Keys stay OUT of the command line so
# they never leak into ps or the journal; ffmpeg receives the URL via exec.
EnvironmentFile=/etc/streamer/secrets.env
ExecStart=/usr/local/bin/streamer-compose
Restart=always
RestartSec=5
# streamer-compose exits 78 (EX_CONFIG) when a key or env file is missing:
# restarting cannot help, so stop and show a readable status instead.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
