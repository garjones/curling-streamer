[Unit]
Description=Streamer compositor, sheet %i
Documentation=file:///opt/streamer/README.md
After=streamer-mediamtx.service
Wants=streamer-mediamtx.service

[Service]
User=streamer
Group=streamer
# GPU access (/dev/dri/renderD128) comes from the streamer user's own
# video/render group membership, which install.sh sets up — a
# SupplementaryGroups= line here would fail the unit outright on a box
# without a "render" group, where install.sh deliberately tolerates it.
EnvironmentFile=/etc/streamer/sheet-%i.env
# Stream keys and camera credentials. Keys stay OUT of the command line so
# they never leak into ps or the journal; ffmpeg receives the URL via exec.
EnvironmentFile=/etc/streamer/secrets.env
# /run/streamer/sheet-N.json: ffmpeg's progress, published by
# streamer-compose for the status page (encoder clock vs wall clock).
# Shared by every sheet, so never removed when one instance stops.
RuntimeDirectory=streamer
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/streamer-compose
Restart=always
RestartSec=5
# streamer-compose exits 78 (EX_CONFIG) when a key or env file is missing:
# restarting cannot help, so stop and show a readable status instead.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
