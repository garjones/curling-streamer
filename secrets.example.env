# streamer secrets — copy to /etc/streamer/secrets.env, then:
#     chown root:root /etc/streamer/secrets.env
#     chmod 600 /etc/streamer/secrets.env
# (systemd reads it as root before dropping to the streamer user, and
# streamer-generate runs as root, so nobody else needs to read it.)
#
# This file must NEVER enter a git repository, a backup that leaves the
# club, or a chat message. Keys stay out of command lines so they cannot
# leak into `ps` or the journal (systemd hands them to ffmpeg as
# environment, and the destination URL is assembled inside the process).

# Camera credentials, referenced from club.yaml as ${CAM_USER}/${CAM_PASS}
CAM_USER=
CAM_PASS=

# One stream key per sheet, from your platform's live dashboard
# (YouTube: Create > Go live > Manage > stream keys). The box makes the
# persistent broadcast for each key itself — README "YouTube notes".
SHEET_1_KEY=
SHEET_2_KEY=

# Optional — streamer-youtube (persistent broadcasts + watch URLs):
# one OAuth client ("TVs and Limited Input devices") in a Google Cloud
# project with the YouTube Data API v3 enabled, one refresh token per
# channel (from `streamer-youtube auth A`), and the club's counter admin
# key so the watch URLs can be written.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN_A=
YT_REFRESH_TOKEN_B=
COUNTER_ADMIN_TOKEN=
