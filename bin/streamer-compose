#!/usr/bin/env python3
"""streamer-compose — build and exec the ffmpeg compositor for one sheet.

Everything comes from the environment (systemd loads sheet-N.env and
secrets.env; see streamer@.service). This script only assembles the
command line — cleanly, with no shell quoting — and execs ffmpeg, so the
ffmpeg process IS the service process and systemd supervises it directly.

Inputs (in order, only those configured):
  0  home camera   RTSP from the local MediaMTX fan-out
  1  away camera   RTSP (layouts with an away tile)
  2  scorebug      raw RGBA over the renderer's named FIFO, 640x360 @ 1 fps
                   (overlay repeats the last frame between updates)
  3  sponsor rail  counter's rail tile over a second FIFO (rail-NN.fifo,
                   same contract as the scorebug), or a static image
  +  silence       anullsrc inside the filter graph; YouTube wants an audio track

GPU vs CPU filtering (FILTER_MODE, default gpu when ENCODER=vaapi):

  gpu  Decode, scale and composite all happen on the GPU: VAAPI hardware
       decode of the cameras, scale_vaapi for the tiles, overlay_vaapi
       onto a GPU canvas, then h264_vaapi. Frames never enter system
       memory, so the CPU does almost nothing per channel.
  cpu  The original graph: software decode, swscale, software overlay,
       then one hwupload per frame into the encoder. Kept as a fallback
       for drivers where the VAAPI filters misbehave.

Why gpu is the default: measured on the pilot box (i7-6700 + Arc A380,
12 Oct 2026) the cpu graph cost ~2 CPU cores *per channel* — two channels
pegged a 4-core machine at 1.06x realtime and six channels managed only
0.68x, while the Arc sat nearly idle doing just the encode. The work is
pixel shuffling, which is what the GPU is for. Re-bench after changing
this (tools/bench.sh).

Exit code 78 (EX_CONFIG) means "configuration missing, retrying is
useless" — the unit's RestartPreventExitStatus stops the restart loop so
`systemctl status streamer@N` shows a plain, human-readable reason.
"""

import os
import sys

EX_CONFIG = 78


def env(key, default=None, required=False):
    v = os.environ.get(key, "")
    if v:
        return v
    if required:
        print(f"streamer-compose: {key} is not set — run streamer-generate",
              file=sys.stderr)
        sys.exit(EX_CONFIG)
    return default


def main():
    sheet = int(env("SHEET", required=True))
    fps = int(env("FPS", "30"))
    canvas_w = int(env("CANVAS_W", "1920"))
    canvas_h = int(env("CANVAS_H", "1080"))
    bitrate_k = int(env("BITRATE_K", "4500"))
    encoder = env("ENCODER", "vaapi")

    # Only the VAAPI encoder can keep frames on the GPU; qsv and x264 must
    # hand software frames to the encoder, so they always filter on the CPU.
    filter_mode = env("FILTER_MODE", "gpu" if encoder == "vaapi" else "cpu")
    if filter_mode not in ("gpu", "cpu"):
        print(f"streamer-compose: FILTER_MODE '{filter_mode}' must be "
              "gpu or cpu", file=sys.stderr)
        sys.exit(EX_CONFIG)
    gpu = (filter_mode == "gpu" and encoder == "vaapi")
    if filter_mode == "gpu" and encoder != "vaapi":
        print(f"streamer-compose: FILTER_MODE=gpu needs ENCODER=vaapi "
              f"(this sheet uses {encoder}) — filtering on the CPU",
              file=sys.stderr)

    cmd = ["ffmpeg", "-hide_banner", "-nostdin", "-loglevel", "warning"]

    # Bench/demo hooks: DURATION caps the run; OUTPUT_OVERRIDE redirects
    # away from the streaming destination. Production sets neither.
    duration = env("DURATION")
    listen = env("RTSP_LISTEN")   # demo only: act as RTSP server on inputs
    if duration:
        # The bench reads ffmpeg's "speed=" progress line, which -loglevel
        # warning suppresses (verified on ffmpeg 9: zero lines without this).
        # Only for timed runs: in production the \r-separated progress
        # output would flood the journal.
        cmd.append("-stats")

    # -- hardware device ---------------------------------------------------
    # gpu mode names the device so both the decoders (-hwaccel_device) and
    # the filter graph (hwupload, *_vaapi) share one VAAPI context; cpu mode
    # only needs a device for the final hwupload before the encoder.
    if encoder == "vaapi":
        vaapi_device = env("VAAPI_DEVICE", "/dev/dri/renderD128")
        if gpu:
            cmd += ["-init_hw_device", f"vaapi=va:{vaapi_device}",
                    "-filter_hw_device", "va"]
        else:
            cmd += ["-vaapi_device", vaapi_device]

    def rtsp_input(url):
        # A camera that stops sending (unplugged, rebooting) must not stall
        # the whole graph for ever: give up after 10 s of socket silence so
        # the input ends and the unit restarts (see overlay() below).
        args = ["-rtsp_transport", "tcp", "-timeout", "10000000"]
        if gpu:
            # Decode straight into VAAPI surfaces — the frames are never
            # touched by the CPU from here to the encoder.
            # allow_profile_mismatch: some cameras signal plain H.264
            # BASELINE (profile 66 without the constraint flag) while the
            # Intel driver only lists CONSTRAINED Baseline. Without this the
            # hardware decoder refuses the stream, ffmpeg silently falls
            # back to software frames and scale_vaapi dies with -38 — five
            # of KCC's twelve cameras, found at the club 13 Oct 2026. What
            # the cameras emit is constrained baseline in all but name, so
            # decoding it as such is correct; a camera using true Baseline
            # extras (FMO/ASO) would show as corruption, visible in the soak.
            args = ["-hwaccel", "vaapi", "-hwaccel_device", "va",
                    "-hwaccel_output_format", "vaapi",
                    "-hwaccel_flags", "allow_profile_mismatch"] + args
        if listen:
            args = ["-rtsp_flags", "listen"] + args
        return args + ["-i", url]

    # The canvas every tile is composited onto.
    #   cpu: a generated black frame, overlaid in software.
    #   gpu: NO generated canvas. The hero camera is scaled and then padded
    #        out to canvas size with pad_vaapi, on the GPU, so nothing is
    #        uploaded per frame and the hero drives the clock. The first
    #        gpu build used color+hwupload here, which cost a 1080p upload
    #        per frame per channel AND free-ran when a camera stopped:
    #        bench 12 Oct 2026 showed a channel whose camera died dropping
    #        111,671 frames at 272% CPU instead of exiting.
    filters = [] if gpu else [
        f"color=c=black:size={canvas_w}x{canvas_h}:rate={fps}[base]"]
    chain = None if gpu else "base"
    idx = 0

    def overlay(src_label, x, y, out_label, live=True):
        # eof_action=endall: when a LIVE input ends (camera gone, renderer
        # restarted), end the output so ffmpeg exits and systemd restarts
        # the unit, which reconnects. The default (repeat) kept the last
        # frame for the rest of the broadcast with the unit still "active"
        # — proved by tools/demo_dropout.sh on 6 Oct 2026. The static
        # sponsor image never ends, so it keeps the default.
        # overlay_vaapi takes the same framesync options as overlay.
        nonlocal chain
        eof = ":eof_action=endall" if live else ""
        f = (f"overlay_vaapi=x={x}:y={y}{eof}" if gpu
             else f"overlay={x}:{y}{eof}")
        filters.append(f"[{chain}][{src_label}]{f}[{out_label}]")
        chain = out_label

    def scale_hw(src, w, h, label):
        """Scale a camera tile: on the GPU in gpu mode, swscale otherwise."""
        if gpu:
            filters.append(
                f"[{src}:v]{REBASE}scale_vaapi=w={w}:h={h}:format=nv12[{label}]")
        else:
            filters.append(f"[{src}:v]{REBASE}scale={w}:{h}[{label}]")

    def upload_tile(src, w, h, label, native):
        """A CPU-side source (FIFO frame, PNG) made ready to composite.

        These arrive at ~1 fps, so scaling them with swscale costs nothing
        and keeps the GPU graph to the filters that matter.
        """
        if gpu:
            pre = "" if native else f"scale={w}:{h},"
            filters.append(f"[{src}:v]{pre}format=nv12,hwupload[{label}]")
        elif native:
            filters.append(f"[{src}:v]copy[{label}]")
        else:
            filters.append(f"[{src}:v]scale={w}:{h}[{label}]")

    # Every LIVE camera input is re-based to start at zero when ffmpeg opens
    # it. The silent audio track (anullsrc) starts at zero; an RTSP stream's
    # timestamps start wherever its clock happens to be. The muxer interleaves
    # by timestamp, so with the hero as the main input the output video
    # carried the camera's offset and the muxer sat waiting for the audio
    # clock to catch up while live frames backed up and dropped: 0.62x,
    # independent of resolution, channel count or GPU load. Found by
    # bisection on the pilot box, 12 Oct 2026 (one graph at a time; the
    # audio track was the last thing added and the thing that broke it).
    # The old graph only avoided this because its generated canvas also
    # started at zero. Scorebug FIFO and sponsor image already start at zero.
    REBASE = "setpts=PTS-STARTPTS,"

    # -- home / hero -------------------------------------------------------
    home = env("HOME_URL", required=True)
    cmd += rtsp_input(home)
    hw, hh = env("HERO_W", "1280"), env("HERO_H", "720")
    hx, hy = env("HERO_X", "0"), env("HERO_Y", "0")
    if gpu:
        filters.append(
            f"[{idx}:v]{REBASE}scale_vaapi=w={hw}:h={hh}:format=nv12,"
            f"pad_vaapi=w={canvas_w}:h={canvas_h}:x={hx}:y={hy}:color=black[v1]")
        chain = "v1"
    else:
        scale_hw(idx, hw, hh, "hero")
        overlay("hero", hx, hy, "v1")
    idx += 1

    # -- away --------------------------------------------------------------
    away = env("AWAY_URL")
    if away:
        cmd += rtsp_input(away)
        scale_hw(idx, env("AWAY_W", "640"), env("AWAY_H", "360"), "away")
        overlay("away", env("AWAY_X", "1280"), env("AWAY_Y", "0"), "v2")
        idx += 1

    # -- scorebug via FIFO -------------------------------------------------
    # NEVER "simplify" this to -loop 1 -i bug.png: ffmpeg decodes a still
    # image once and caches it forever (verified by experiment, twice —
    # see counter/README.md). The FIFO carries raw RGBA at ~1 fps and
    # overlay's default repeatlast holds the frame between updates.
    fifo = env("FIFO")
    if fifo:
        cmd += ["-f", "rawvideo", "-pix_fmt", "rgba",
                "-video_size", "640x360", "-framerate", "1", "-i", fifo]
        bw, bh = env("BUG_W", "640"), env("BUG_H", "360")
        upload_tile(idx, bw, bh, "bug", native=(bw, bh) == ("640", "360"))
        overlay("bug", env("BUG_X", "1280"), env("BUG_Y", "360"), "v3")
        idx += 1

    # -- sponsor rail ------------------------------------------------------
    # Preferred: counter's /rail tile over its own FIFO, exactly like the
    # scorebug (RAIL_FIFO, from club.yaml `sponsor_rail: counter`). The club
    # changes sponsors on counter's admin page and the renderer pushes a new
    # frame; nothing here restarts. Live input, so eof_action=endall like
    # the bug: a renderer restart ends ffmpeg and the unit reconnects.
    rail_fifo = env("RAIL_FIFO")
    sponsor = env("SPONSOR")
    if rail_fifo:
        cmd += ["-f", "rawvideo", "-pix_fmt", "rgba",
                "-video_size", "640x360", "-framerate", "1", "-i", rail_fifo]
        rw, rh = env("RAIL_W", "640"), env("RAIL_H", "360")
        upload_tile(idx, rw, rh, "rail", native=(rw, rh) == ("640", "360"))
        overlay("rail", env("RAIL_X", "640"), env("RAIL_Y", "360"), "v4")
        idx += 1
    # Alternative: a static image (safe with -loop because it never changes
    # while ffmpeg runs; changing it means a restart).
    elif sponsor:
        if not os.path.exists(sponsor):
            # ffmpeg would exit 1 and the unit would restart every 5 s; a
            # missing file is configuration, so park with a readable reason.
            print(f"streamer-compose: sponsor image {sponsor} does not exist — "
                  "copy it there (or remove sponsor_image from club.yaml and "
                  "re-run streamer-generate), then systemctl restart "
                  f"streamer@{sheet}", file=sys.stderr)
            sys.exit(EX_CONFIG)
        cmd += ["-loop", "1", "-framerate", "1", "-i", sponsor]
        upload_tile(idx, env("RAIL_W", "1920"), env("RAIL_H", "360"),
                    "rail", native=False)
        overlay("rail", env("RAIL_X", "0"), env("RAIL_Y", "720"), "v4",
                live=False)
        idx += 1

    # -- silent audio ------------------------------------------------------
    # Generated INSIDE the filter graph, not as a separate `-f lavfi -i`
    # input. With real cameras (club, 13 Oct 2026) a standalone anullsrc
    # input ran at ~0.2-0.3x of real time and the muxer, interleaving video
    # with it, dragged the whole stream down to the same pace: the video
    # finished its 30 s in 20 s wall and ffmpeg then sat 70 s waiting for
    # the audio to catch up (A1/A2 vs A3 in the deployment notes). -re on
    # the input did not help; a graph-driven source, pulled only as fast
    # as the output consumes it, runs at 1.03x. The synthetic bench never
    # showed this; the mechanism is not understood, only the fix is proven.
    filters.append("anullsrc=channel_layout=stereo:sample_rate=44100[aout]")

    # -- encoder -----------------------------------------------------------
    if encoder == "vaapi":
        if gpu:
            vout = chain          # already VAAPI surfaces; nothing to upload
        else:
            filters.append(f"[{chain}]format=nv12,hwupload[vout]")
            vout = "vout"
        venc = ["-c:v", "h264_vaapi"]
    elif encoder == "qsv":
        filters.append(f"[{chain}]format=nv12[vout]")
        vout = "vout"
        venc = ["-c:v", "h264_qsv", "-preset", "medium"]
    else:  # x264 — software fallback, also what the container demo uses
        filters.append(f"[{chain}]format=yuv420p[vout]")
        vout = "vout"
        venc = ["-c:v", "libx264", "-preset", "veryfast"]

    cmd += ["-filter_complex", ";".join(filters),
            "-map", f"[{vout}]", "-map", "[aout]"]
    cmd += venc + [
        "-b:v", f"{bitrate_k}k", "-maxrate", f"{bitrate_k}k",
        "-bufsize", f"{bitrate_k * 2}k",
        "-g", str(fps * 2), "-r", str(fps),
        "-c:a", "aac", "-b:a", "128k", "-ar", "44100",
    ]
    if duration:
        cmd += ["-t", duration]

    # -- destination -------------------------------------------------------
    override = env("OUTPUT_OVERRIDE")
    if override:
        out = ["-f", "null", "-"] if override == "null" \
            else ["-f", "flv", override] if override.startswith("rtmp") \
            else ["-y", override]
    else:
        key = env(f"SHEET_{sheet}_KEY")
        if not key:
            print(f"streamer-compose: no stream key for sheet {sheet} — "
                  f"set SHEET_{sheet}_KEY in /etc/streamer/secrets.env, "
                  "then systemctl restart streamer@" + str(sheet),
                  file=sys.stderr)
            sys.exit(EX_CONFIG)
        dest = env("DEST_URL", required=True).rstrip("/")
        out = ["-f", "flv", f"{dest}/{key}"]
    cmd += out

    print(f"streamer-compose: sheet {sheet} ({filter_mode} filtering) ->",
          " ".join(c if not c.startswith("rtmp") else "rtmp://…<key>"
                   for c in cmd), flush=True)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
