#!/usr/bin/env python3
"""streamer-generate — turn club.yaml + secrets.env into runtime config.

Reads   /etc/streamer/club.yaml     (the club's one configuration file)
        /etc/streamer/secrets.env   (camera credentials + stream keys;
                                     never committed anywhere, mode 600)
Writes  /etc/streamer/mediamtx.yml  (camera fan-out; credentials embedded,
                                     which is why it is written mode 640)
        /etc/streamer/sheet-N.env   (one per selected sheet, read by
                                     streamer@N.service)
        /etc/streamer/status.json   (what the status page monitors)

Run it again after any change to club.yaml or secrets.env, then
`systemctl restart 'streamer@*' streamer-mediamtx`.

The generator is deliberately dumb: it validates, expands ${VARS} from
secrets.env, computes tile geometry from the layout preset, and writes
plain files a human can read. No daemon, no state.
"""

import argparse
import grp
import json
import os
import re
import stat
import sys

try:
    import yaml
except ImportError:
    sys.exit("streamer-generate: python3-yaml is not installed "
             "(apt-get install python3-yaml)")

BUG_W, BUG_H = 640, 360          # fixed by counter's scorebug contract
SERVICE_GROUP = "streamer"       # the group every systemd unit runs as

# Layout presets. Tiles are fractions of the canvas; the scorebug tile is
# scaled only if the slot differs from 640x360 (at 1920x1080 it is native).
#   hero-away-bug-rail — two cameras + bug + rail: hero top-left, away camera
#     top-right, scorebug under it, sponsor rail across the bottom.
#   full-bug — one camera full-frame, scorebug bottom-right.
#   quad — both houses the same size, side by side on top; scorebug
#     bottom-left, sponsor panel bottom-right. Nothing depends on which end is
#     in play, which alternates every end (Gareth, 13 Oct 2026 — the
#     hero/away layout only reads right for half the ends). At 1280x720
#     every tile is 640x360: cameras at 0.75x, scorebug at native size.
#     "hero" here is simply the home camera, left.
LAYOUTS = {
    "hero-away-bug-rail": {
        "hero": (0, 0, 2 / 3, 2 / 3),
        "away": (2 / 3, 0, 1 / 3, 1 / 3),
        "bug":  (2 / 3, 1 / 3, 1 / 3, 1 / 3),
        "rail": (0, 2 / 3, 1, 1 / 3),
    },
    "full-bug": {
        "hero": (0, 0, 1, 1),
        "bug":  None,            # anchored bottom-right at native size
    },
    "quad": {
        "hero": (0, 0, 1 / 2, 1 / 2),
        "away": (1 / 2, 0, 1 / 2, 1 / 2),
        "bug":  (0, 1 / 2, 1 / 2, 1 / 2),
        "rail": (1 / 2, 1 / 2, 1 / 2, 1 / 2),  # 16:9 sponsor panel
    },
}


def die(msg):
    sys.exit(f"streamer-generate: ERROR: {msg}")


def warn(msg):
    print(f"streamer-generate: WARNING: {msg}", file=sys.stderr)


def read_secrets(path):
    """KEY=VALUE lines; systemd EnvironmentFile syntax, no expansion."""
    secrets = {}
    if not os.path.exists(path):
        warn(f"{path} not found — camera URLs with ${{VARS}} and stream "
             "keys will be missing")
        return secrets
    mode = stat.S_IMODE(os.stat(path).st_mode)
    if mode & 0o077:
        warn(f"{path} is mode {oct(mode)}; it holds credentials and "
             "should be 600")
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            secrets[k.strip()] = v.strip().strip('"')
    return secrets


def expand(text, secrets, context):
    def sub(m):
        var = m.group(1)
        if var not in secrets:
            die(f"{context}: ${{{var}}} is not defined in secrets.env")
        return secrets[var]
    return re.sub(r"\$\{(\w+)\}", sub, text)


def geometry(layout_name, canvas_w, canvas_h):
    preset = LAYOUTS.get(layout_name)
    if preset is None:
        die(f"unknown layout '{layout_name}' "
            f"(known: {', '.join(sorted(LAYOUTS))})")
    tiles = {}
    for name, frac in preset.items():
        if frac is None:                       # bug anchored bottom-right
            tiles[name] = (canvas_w - BUG_W, canvas_h - BUG_H, BUG_W, BUG_H)
            continue
        fx, fy, fw, fh = frac
        # Round to EVEN pixels: nv12 chroma is subsampled 2x2, and the
        # VAAPI scalers/overlays reject odd sizes and offsets. A 1280x720
        # canvas would otherwise produce a 853-wide hero and 427-wide
        # tiles. Tiles still butt together: x+w of the left tile is the
        # even x of the right one.
        even = lambda v: int(round(v / 2.0)) * 2
        x, y = even(canvas_w * fx), even(canvas_h * fy)
        w = even(canvas_w * (fx + fw)) - x
        h = even(canvas_h * (fy + fh)) - y
        tiles[name] = (x, y, w, h)
    return tiles


def parse_sheet_selector(spec, available):
    if not spec:
        return available
    chosen = set()
    try:
        for part in spec.split(","):
            if "-" in part:
                lo, hi = part.split("-", 1)
                chosen.update(range(int(lo), int(hi) + 1))
            else:
                chosen.add(int(part))
    except ValueError:
        die(f"--sheets '{spec}' is not a list of sheet numbers "
            "(examples: 1-6, 2,4,9)")
    missing = chosen - set(available)
    if missing:
        die(f"--sheets asks for {sorted(missing)} but club.yaml only "
            f"defines {sorted(available)}")
    return sorted(chosen)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--etc", default=os.environ.get("STREAMER_ETC",
                                                    "/etc/streamer"),
                    help="config directory (default /etc/streamer)")
    ap.add_argument("--sheets", default="",
                    help="sheets THIS box carries, e.g. 1-6 or 2,4,9 "
                         "(default: every sheet in club.yaml)")
    args = ap.parse_args()
    etc = args.etc

    club_path = os.path.join(etc, "club.yaml")
    if not os.path.exists(club_path):
        die(f"{club_path} not found — copy club.example.yaml there and "
            "fill it in")
    with open(club_path) as f:
        club = yaml.safe_load(f)
    secrets = read_secrets(os.path.join(etc, "secrets.env"))

    name = club.get("club") or die("club.yaml: 'club' (slug) is required")
    canvas = str(club.get("canvas", "1920x1080"))
    m = re.fullmatch(r"(\d+)x(\d+)", canvas)
    if not m:
        die(f"club.yaml: canvas '{canvas}' is not WxH")
    canvas_w, canvas_h = int(m.group(1)), int(m.group(2))
    fps = int(club.get("fps", 30))
    bitrate_k = int(club.get("bitrate_k", 4500))
    encoder = club.get("encoder", "vaapi")
    if encoder not in ("vaapi", "qsv", "x264"):
        die(f"club.yaml: encoder '{encoder}' must be vaapi, qsv or x264")
    # Where scaling and compositing happen. gpu keeps every frame on the
    # GPU (VAAPI decode -> scale_vaapi -> overlay_vaapi -> encode) and is
    # what makes six sheets fit on one box; cpu is the software fallback
    # for drivers where the VAAPI filters misbehave. See streamer-compose.
    filtering = str(club.get("filtering", "gpu" if encoder == "vaapi" else "cpu"))
    if filtering not in ("gpu", "cpu"):
        die(f"club.yaml: filtering '{filtering}' must be gpu or cpu")
    if filtering == "gpu" and encoder != "vaapi":
        warn(f"filtering: gpu needs encoder: vaapi (this club uses "
             f"{encoder}) — filtering on the CPU instead")
        filtering = "cpu"
    layout = club.get("layout", "hero-away-bug-rail")
    counter_server = club.get("counter_server")  # None => no scorebug
    sponsor = club.get("sponsor_image")          # None => no rail
    dest_default = club.get("destination_default",
                            "rtmp://a.rtmp.youtube.com/live2")
    rtsp_base = club.get("rtsp_base", "rtsp://127.0.0.1:8554")
    vaapi_device = club.get("vaapi_device", "/dev/dri/renderD128")

    sheets_cfg = club.get("sheets") or die("club.yaml: 'sheets' is required")
    by_n = {}
    for s in sheets_cfg:
        n = int(s["n"])
        if n in by_n:
            die(f"club.yaml: sheet {n} defined twice")
        by_n[n] = s
    selected = parse_sheet_selector(args.sheets, sorted(by_n))

    tiles = geometry(layout, canvas_w, canvas_h)
    needs_away = "away" in tiles
    if sponsor and "rail" not in tiles:
        warn(f"layout '{layout}' has no sponsor rail; sponsor_image ignored")
    if sponsor and not os.path.exists(sponsor):
        warn(f"sponsor_image {sponsor} does not exist (yet)")

    # ---- mediamtx.yml: one pull per camera, everything reads from us ----
    # Credentials end up in this file, which is why it is written 640 and
    # lives in /etc/streamer. The cameras are only ever asked for their
    # DEFAULT stream (no query parameters): identical streams mean an old
    # camera encodes once no matter how many local consumers we have.
    paths = {}
    cam_hosts = {}
    for n in selected:
        s = by_n[n]
        for role in (("home", "away") if needs_away else ("home",)):
            url = s.get(role) or die(f"sheet {n}: '{role}' camera URL "
                                     f"required by layout '{layout}'")
            url = expand(url, secrets, f"sheet {n} {role}")
            paths[f"cam-{n}-{role}"] = {
                "source": url,
                "sourceOnDemand": True,
            }
            host = re.sub(r"^rtsp://(?:[^@/]*@)?([^:/]+).*", r"\1", url)
            cam_hosts.setdefault(n, {})[role] = host

    mediamtx = {
        # Keep the surface small: RTSP only, loopback API off, no HLS/RTMP/
        # WebRTC/SRT servers. Local consumers (compositor, kiosk TVs, VLC)
        # read rtsp://<box>:8554/cam-N-role.
        "logLevel": "info",
        "api": False,
        "metrics": False,
        "pprof": False,
        "playback": False,
        "rtmp": False,
        "hls": False,
        "webrtc": False,
        "srt": False,
        # MoQ is on by default in the pinned v1.19.1 and wants to write a
        # self-signed certificate into the working directory, which the
        # unit's ProtectSystem=strict forbids: two warnings per start and
        # an unwanted listener on :8892. Found 6 Oct 2026.
        "moq": False,
        "paths": paths,
    }
    os.makedirs(etc, exist_ok=True)
    mtx_path = os.path.join(etc, "mediamtx.yml")
    with open(mtx_path, "w") as f:
        yaml.safe_dump(mediamtx, f, sort_keys=False)
    # 640 keeps the camera password from other users, but streamer-mediamtx
    # runs as the unprivileged service user, so the file must belong to its
    # group — root:root 640 (what a plain chmod leaves when run via sudo)
    # made MediaMTX unable to read its own config. Found in the 26 Sep 2026
    # check, before any hardware existed.
    os.chmod(mtx_path, 0o640)
    if os.geteuid() == 0:
        try:
            os.chown(mtx_path, 0, grp.getgrnam(SERVICE_GROUP).gr_gid)
        except KeyError:
            warn(f"group '{SERVICE_GROUP}' does not exist — run install.sh; "
                 f"until then streamer-mediamtx cannot read {mtx_path}")

    # ---- per-sheet env files, read by streamer@N.service ----------------
    for n in selected:
        hx, hy, hw, hh = tiles["hero"]
        lines = {
            "SHEET": n,
            "CLUB": name,
            "CANVAS_W": canvas_w, "CANVAS_H": canvas_h,
            "FPS": fps, "BITRATE_K": bitrate_k,
            "ENCODER": encoder, "VAAPI_DEVICE": vaapi_device,
            "FILTER_MODE": filtering,
            "HOME_URL": f"{rtsp_base}/cam-{n}-home",
            "HERO_X": hx, "HERO_Y": hy, "HERO_W": hw, "HERO_H": hh,
            "DEST_URL": dest_default,
        }
        if needs_away:
            ax, ay, aw, ah = tiles["away"]
            lines.update(AWAY_URL=f"{rtsp_base}/cam-{n}-away",
                         AWAY_X=ax, AWAY_Y=ay, AWAY_W=aw, AWAY_H=ah)
        if counter_server:
            bx, by_, bw, bh = tiles["bug"]
            lines.update(FIFO=f"/run/counter/bug-{n:02d}.fifo",
                         BUG_X=bx, BUG_Y=by_, BUG_W=bw, BUG_H=bh)
        if sponsor and "rail" in tiles:
            rx, ry, rw, rh = tiles["rail"]
            lines.update(SPONSOR=sponsor,
                         RAIL_X=rx, RAIL_Y=ry, RAIL_W=rw, RAIL_H=rh)
        env_path = os.path.join(etc, f"sheet-{n}.env")
        with open(env_path, "w") as f:
            f.write(f"# generated by streamer-generate from club.yaml — "
                    f"edit club.yaml, not this\n")
            for k, v in lines.items():
                f.write(f"{k}={v}\n")
        os.chmod(env_path, 0o644)
        if not secrets.get(f"SHEET_{n}_KEY"):
            warn(f"sheet {n}: SHEET_{n}_KEY missing or blank in secrets.env — "
                 f"streamer@{n} will refuse to start until it is set")

    # ---- what the status page watches -----------------------------------
    status = {
        "club": name,
        "counter_server": counter_server,
        "sheets": [{"n": n, "cameras": cam_hosts.get(n, {})}
                   for n in selected],
    }
    with open(os.path.join(etc, "status.json"), "w") as f:
        json.dump(status, f, indent=2)

    # ---- renderer env ----------------------------------------------------
    # streamer-renderer.service has ConditionFileNotEmpty on this file, so
    # a club with no scorebug gets a genuinely EMPTY file and the unit
    # stays quietly inactive. (A comment line alone used to start the
    # renderer with no server, which crashed every 5 s. Found 6 Oct 2026.)
    rend_path = os.path.join(etc, "renderer.env")
    with open(rend_path, "w") as f:
        if counter_server:
            f.write("# generated by streamer-generate from club.yaml\n")
            f.write(f"COUNTER_SERVER={counter_server}\nCOUNTER_CLUB={name}\n")
            f.write(f"RENDERER_SHEETS={','.join(str(n) for n in selected)}\n")

    print(f"streamer-generate: wrote config for sheets "
          f"{','.join(str(n) for n in selected)} "
          f"({layout} @ {canvas}, {encoder}/{filtering}, {fps} fps, "
          f"{bitrate_k}k)")
    print("apply with: systemctl restart streamer-mediamtx "
          "streamer-renderer 'streamer@*'")


if __name__ == "__main__":
    main()
